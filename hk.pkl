amends "package://github.com/jdx/hk/releases/download/v2.14.0/hk@2.14.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.14.0/hk@2.14.0#/Builtins.pkl"
import "package://github.com/hugoh/hk-config/releases/download/v3.3.0/hk-config@3.3.0#/base.pkl" as Base

min_hk_version = Base.min_hk_version

local common = new Mapping<String, Step> {
    ...Base.base
    ...Base.python
}

local linters = (common) {
    // Python - run via this project's own uv-managed tools, not PATH binaries
    ["ruff"] = (Builtins.ruff) {
        check = "uv run ruff check --force-exclude {{ files }}"
        fix = "uv run ruff check --force-exclude --fix {{ files }}"
    }
    ["ruff_format"] = (Builtins.ruff_format) {
        check_diff = "uv run ruff format --quiet --force-exclude --diff {{ files }}"
        fix = "uv run ruff format --quiet --force-exclude {{ files }}"
    }
    ["uv-sync"] {
        check = "uv sync --all-extras"
    }
    ["ty"] = (Builtins.ty) {
        check = "uv run ty check {{ files }}"
        depends = List("uv-sync")
    }
    ["tests"] {
        check = "uv run coverage run -m unittest discover -s tests -t . && uv run coverage report"
        profiles = List("ci")
        depends = List("uv-sync")
    }
    ["package-check"] {
        check = "mise run package-check"
        profiles = List("ci")
    }
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = linters
    }
    ["pre-push"] {
        steps = linters
    }
    ["check"] {
        steps = linters
    }
    ["fix"] {
        fix = true
        steps = linters
    }
    ["commit-msg"] {
        steps = new Mapping<String, Step> {
            ...Base.commit_msg
        }
    }
}
