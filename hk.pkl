amends "package://github.com/jdx/hk/releases/download/v2.12.0/hk@2.12.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.12.0/hk@2.12.0#/Builtins.pkl"
import "package://github.com/hugoh/hk-config/releases/download/v3.1.5/hk-config@3.1.5#/base.pkl" as Base

min_hk_version = Base.min_hk_version

local linters = new Mapping<String, Step> {
    ...Base.base

    // Python - run via this project's own uv-managed tools, not PATH binaries
    ...Base.python
    ["ruff"] = (Builtins.ruff) {
        check = "uv run ruff check --force-exclude {{ files }}"
        fix = "uv run ruff check --force-exclude --fix {{ files }}"
    }
    ["ruff_format"] = (Builtins.ruff_format) {
        check_diff = "uv run ruff format --quiet --force-exclude --diff {{ files }}"
        fix = "uv run ruff format --quiet --force-exclude {{ files }}"
    }
    ["uv-sync"] {
        check = "uv sync --all-extras"
    }
    ["ty"] = (Builtins.ty) {
        check = "uv run ty check {{ files }}"
        depends = List("uv-sync")
    }
    ["tests"] {
        check = "uv run python -m unittest discover -s tests -t ."
        profiles = List("ci")
        depends = List("uv-sync")
    }
    ["package-check"] {
        check = "mise run package-check"
        profiles = List("ci")
    }
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = linters
    }
    ["pre-push"] {
        steps = linters
    }
    ["check"] {
        steps = linters
    }
    ["fix"] {
        fix = true
        steps = linters
    }
    ["commit-msg"] {
        steps = new Mapping<String, Step> {
            ...Base.commit_msg
        }
    }
}
